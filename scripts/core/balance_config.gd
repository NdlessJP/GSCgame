class_name BalanceConfig
extends Resource
## Every tunable combat number lives here so balance can be adjusted without
## touching combat code.  `BalanceConfig.new()` already yields the documented
## prototype values, so tests and tools can use a default instance without
## needing the project autoload.

@export_group("Damage")
## Constant used by the defense mitigation curve:
##   mitigation = base * (defense_constant / (defense_constant + target_defense))
@export var defense_constant: float = 100.0
@export var critical_rate: float = 0.08
@export var critical_multiplier: float = 1.6
## Multiplier applied to damage dealt to a Broken target.
@export var broken_damage_multiplier: float = 1.25
## Random damage spread, 0.1 == +/-10%. Kept at 0.0 by default so results are
## deterministic and therefore testable.
@export var damage_variance: float = 0.0
@export var minimum_damage: float = 1.0

@export_group("Elements")
@export var element_advantage_multiplier: float = 1.5
@export var element_neutral_multiplier: float = 1.0

@export_group("Arts")
@export var arts_max: float = 200.0
@export var arts_cost: float = 100.0
@export var true_arts_cost: float = 200.0
## Arts generated by a successful basic attack.
@export var arts_per_basic_attack: float = 12.0
## Additional arts generated when a Skill is used.
@export var arts_per_skill: float = 15.0

@export_group("Break")
## Break damage contributed by a basic attack (added to the ability value).
@export var break_damage_per_basic_attack: float = 5.0
## How long a unit stays Broken when its meter empties.
@export var break_duration: float = 4.0

@export_group("Progression")
@export var xp_base: int = 80
@export var xp_per_level: int = 60
@export var currency_per_quest: int = 60

@export_group("Battle Flow")
## Seconds of preparation before the first wave and between waves.
@export var wave_break_seconds: float = 2.0


## Returns a fresh configuration populated with the documented defaults.
static func make_default() -> BalanceConfig:
	return BalanceConfig.new()
