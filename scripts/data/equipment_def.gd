class_name EquipmentDef
extends Resource
## Static definition of an equippable item.
##
## Items come in three categories that map onto the equipment slots:
##   ATTACK  - offence oriented
##   DEFENSE - survivability oriented
##   SUPPORT - utility oriented

enum Category { ATTACK, DEFENSE, SUPPORT }

const CATEGORY_NAMES: Dictionary = {
	Category.ATTACK: "Attack",
	Category.DEFENSE: "Defense",
	Category.SUPPORT: "Support",
}

@export_group("Identity")
@export var id: StringName = &""
@export var display_name: String = ""
@export var description: String = ""
@export var category: Category = Category.ATTACK
## When true only one copy of this item can exist in the inventory.
@export var unique_item: bool = true

@export_group("Passive Stats")
@export var attack_percent: float = 0.0
@export var defense_percent: float = 0.0
@export var magic_percent: float = 0.0
@export var magic_defense_percent: float = 0.0
@export var attack_flat: float = 0.0
@export var defense_flat: float = 0.0
@export var max_hp_flat: float = 0.0
## Arts generated by each basic attack while the item is equipped.
@export var arts_per_attack: float = 0.0

@export_group("Active Ability")
## Optional active ability with its own cooldown, usable in battle.
@export var active_ability: AbilityDef = null

@export_group("Presentation")
## Placeholder colour used by the item icons.
@export var icon_color: Color = Color(0.8, 0.8, 0.85)


func category_name() -> String:
	return CATEGORY_NAMES.get(category, "Unknown")
